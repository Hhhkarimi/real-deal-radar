{
  "name": "torob-mcp",
  "version": "0.1.0",
  "description": "Unofficial, read-only Torob MCP server with stdio and Streamable HTTP transports",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/stdio.js",
    "start:http": "node dist/http.js",
    "dev": "node --watch dist/stdio.js",
    "dev:http": "node --watch dist/http.js",
    "test": "npm run build && node --test --test-isolation=none test/*.test.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "check": "npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@modelcontextprotocol/node": "2.1.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "^24.0.0",
    "typescript": "6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hhhkarimi/Hossein-Karimi-AI-Library.git",
    "directory": "mcp/torob-mcp"
  },
  "homepage": "https://github.com/Hhhkarimi/Hossein-Karimi-AI-Library/tree/main/mcp/torob-mcp"
}
